# TeachSense backend example env file
# Copy this to `.env` in the `backend/` folder and fill values for your deployment.

# Django
DJANGO_SECRET_KEY=change-me
OPENAI_API_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,teachsense.onrender.com

# Optional: when deploying on Render, set the external hostname (hostname only)
# Example: RENDER_EXTERNAL_HOSTNAME=teachsense.onrender.com
RENDER_EXTERNAL_HOSTNAME=teachsense.onrender.com

# Cookie / CSRF settings to control cross-site behavior.
# Use 'None' to allow cross-site cookies (requires Secure=true in production/HTTPS).
# Valid values: 'Lax', 'Strict', 'None'
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None

# Optional: set the cookie domain (e.g. yourdomain.com) when you want cookies shared
# across subdomains. Leave empty for default behavior.
SESSION_COOKIE_DOMAIN=

# CORS / CSRF trusted origins (comma-separated; override in settings via env vars)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://teachsense.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://teachsense.onrender.com

# Frontend URL (may include path). The settings will extract and use the origin only.
# Example: FRONTEND_URL=https://teachsense-frontend.onrender.com/docs/
FRONTEND_URL=https://teachsense-frontend.onrender.com/docs/
# Redis / DB / other variables (examples)
# REDIS_URL=redis://localhost:6379/0
#
# Database
# - Local dev: DB_NAME=./db.sqlite3
# - Production: DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Keep the old DB_* variables only if you are not using DATABASE_URL.

# Notes:
# - In production (DJANGO_DEBUG=false) ensure your site uses HTTPS; cookies with
#   SAMESITE=None require Secure=True (the settings file will set that when DEBUG=false).
# - Do NOT commit secrets (like real DJANGO_SECRET_KEY) to VCS. Use your platform's
#   secret management or protected env variables.
