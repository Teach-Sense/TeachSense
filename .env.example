DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

APP_NAME=TeachSense
APP_PORT=8000
API_BASE_URL=http://localhost:8000
FRONTEND_LECTURER_URL=http://localhost:3000
FRONTEND_STUDENT_URL=http://localhost:3001

DB_ENGINE=django.db.backends.postgresql
DB_NAME=teachsense_db
DB_USER=teachsense_user
DB_PASSWORD=teachsense_password
DB_HOST=localhost
DB_PORT=5432
# For local quick start, you can use sqlite:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=/home/sulayman/teachsense-backend/db.sqlite3

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

STT_PROVIDER=openai
STT_MODEL=gpt-4o-mini-transcribe
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=teachsense-assets

ESP32_DEVICE_SHARED_SECRET=change-me
ESP32_AUDIO_CHUNK_SECONDS=10
ESP32_HEARTBEAT_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO
SENTRY_DSN=

SESSION_DEFAULT_QUESTION_COUNT=5
SESSION_AUTO_QUESTION_MODE=true
SESSION_MAX_DURATION_MINUTES=180

SCORE_WEIGHT_CONTENT_COVERAGE=0.35
SCORE_WEIGHT_CLARITY=0.25
SCORE_WEIGHT_ENGAGEMENT=0.20
SCORE_WEIGHT_COMPREHENSION=0.20
