# --- Core ---
DEBUG=False
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3

# --- MATLAB advanced audio processing (OPTIONAL) ---
# Disabled by default. The platform runs with pure-Python preprocessing
# when MATLAB is unavailable or disabled.
ENABLE_MATLAB=False
MATLAB_START_TIMEOUT=60
MATLAB_CALL_TIMEOUT=120
MATLAB_RETRIES=2
